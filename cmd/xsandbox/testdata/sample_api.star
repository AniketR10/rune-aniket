# -- per-service success notifications -------------------------------
# The extension confirms each service succeeded with a notification.
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: filesystem ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: executor ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: terminal ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: storage ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: windowmanager ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: notifications ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: resourceopener ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: interrupter ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: editor ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: parser ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: lsp ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: llm ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: debugger ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: config ok"})
expect_rpc("browser.Notifications/Notify", where = {"msg": "demo: accessors ok"})
