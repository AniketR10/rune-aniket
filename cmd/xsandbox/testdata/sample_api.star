expect_rpc("debug.Debugger/Launch")
expect_rpc("debug.Debugger/Attach")
expect_rpc("debug.Debugger/ConfigurationDone")
expect_rpc("debug.Debugger/SetBreakpoints")
expect_rpc("debug.Debugger/SetFunctionBreakpoints")
expect_rpc("debug.Debugger/SetExceptionBreakpoints")
expect_rpc("debug.Debugger/Continue")
expect_rpc("debug.Debugger/Next")
expect_rpc("debug.Debugger/StepIn")
expect_rpc("debug.Debugger/StepOut")
expect_rpc("debug.Debugger/StepBack")
expect_rpc("debug.Debugger/ReverseContinue")
expect_rpc("debug.Debugger/Pause")
