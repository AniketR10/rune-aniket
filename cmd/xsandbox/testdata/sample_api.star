# Drives testdata/sampleext's "api" command, which exhaustively
# exercises EVERY method of every interface reachable through
# extensionapi.Workspace. This spec asserts the whole per-method RPC
# surface in the DSL itself (not just in Go), so it doubles as an
# end-to-end exercise of the .star matching language: every service
# method must be observed, a handful with `where` field matches, plus
# every per-service success notification.
expect_metadata(id = "xsandbox_sample")
config({"prefix": "demo"})
fs.write("VERSION", "9.9.9\n")

a = expect_command("api")
invoke_command(a, timeout = "20s")

# -- representative RPCs asserted with `where` field matching ---------
# These prove the DSL matches nested proto fields, not just method
# names, across every kind of service (unary, streaming, handler).
expect_rpc("workspace.Scheme/MkdirAll", where = {"path": "probe-dir"})
expect_rpc("workspace.Executor/StartCommand", where = {"start": {"name": "/bin/echo"}})
expect_rpc("proto.DocumentStore/Set", where = {"id": "probe"})
expect_rpc("proto.DocumentStore/Get", where = {"id": "probe"})
expect_rpc("browser.EventPublisher/Publish", where = {"ev": {"type": "TypeInterrupt"}})
expect_rpc("text.Editor/Editor")
expect_rpc("syntax.Syntax/Search", where = {"query": "(x) @y"})
expect_rpc("semantic.LSP/WorkspaceSymbol", where = {"query": "probe"})
expect_rpc("debug.Debugger/CreateSession", where = {"lang_id": "go"})

# -- exhaustive per-method surface -----------------------------------
# Every remaining method of every interface, asserted by name. Order
# is irrelevant: each expectation consumes the earliest unconsumed
# matching call.

# workspace.Files / workspace.Scheme (FileSystem)
expect_rpc("workspace.Scheme/URI")
expect_rpc("workspace.Scheme/Open")
expect_rpc("workspace.Scheme/Stat")
expect_rpc("workspace.Scheme/ReadDir")
expect_rpc("workspace.Scheme/Remove")
expect_rpc("workspace.Files/Read")
expect_rpc("workspace.Files/Close")

# workspace.Executor
expect_rpc("workspace.Executor/Signal")

# workspace.Terminal
expect_rpc("workspace.Terminal/NewPty")
expect_rpc("workspace.Terminal/SetPtySize")

# proto.DocumentStore (Storage)
expect_rpc("proto.DocumentStore/Create")
expect_rpc("proto.DocumentStore/Update")
expect_rpc("proto.DocumentStore/List")
expect_rpc("proto.DocumentStore/Delete")

# browser.WindowManager
expect_rpc("browser.WindowManager/Focus")
expect_rpc("browser.WindowManager/Split")
expect_rpc("browser.WindowManager/SetContent")
expect_rpc("browser.WindowManager/CloseWindow")
expect_rpc("browser.WindowManager/Bar")
expect_rpc("browser.WindowManager/Tab")

# browser.Notifications / browser.ResourceOpener
expect_rpc("browser.Notifications/NotifyOnce")
expect_rpc("browser.Notifications/UpdateNotificationProgress")
expect_rpc("browser.ResourceOpener/Open")

# text.Editor
expect_rpc("text.Editor/SubscribeCommand")
expect_rpc("text.Editor/SubscribeREPLCommand")
expect_rpc("text.Editor/SubscribeEvent")

# config.Config
expect_rpc("config.Config/Get")

# syntax.Syntax (Parser)
expect_rpc("syntax.Syntax/SearchNode")
expect_rpc("syntax.Syntax/Query")
expect_rpc("syntax.Syntax/QueryNode")
expect_rpc("syntax.Syntax/Highlight")
expect_rpc("syntax.Syntax/ResolveSymbol")
expect_rpc("syntax.Syntax/ListReferencedSymbols")

# llm.LLM
expect_rpc("llm.LLM/CreateCompletion")
expect_rpc("llm.LLM/CountTokens")
expect_rpc("llm.LLM/Models")
expect_rpc("llm.LLM/GetModel")

