expect_rpc("debug.Debugger/StackTrace")
expect_rpc("debug.Debugger/Scopes")
expect_rpc("debug.Debugger/Variables")
expect_rpc("debug.Debugger/SetVariable")
expect_rpc("debug.Debugger/Source")
expect_rpc("debug.Debugger/Evaluate")
expect_rpc("debug.Debugger/SetExpression")
