func TestSupersededMemoriesSkipped(t *testing.T) {
	orig := registry
	defer func() { registry = orig }()

	old := testEpisodicMemory{}         // id: "test-episodic"
	replacement := testSupersedingMemory{} // supersedes "test-episodic"
	registry = []Memory{old, replacement}

	superseded := make(map[string]bool)
	for _, m := range registry {
		if s, ok := m.(Supersedes); ok {
			for _, id := range s.Supersedes() {
				superseded[id] = true
			}
		}
	}

	if !superseded["test-episodic"] {
		t.Fatal("expected test-episodic to be superseded")
	}
	if superseded["test-superseding"] {
		t.Fatal("the superseding memory should not be superseded itself")
	}
}

func TestDependencyExpansion(t *testing.T) {
	orig := registry
	defer func() { registry = orig }()

	dep := testMemory{}                 // id: "test-memory"
	parent := testDependentMemory{}     // depends on "test-memory"
	registry = []Memory{dep, parent}

	byID := make(map[string]Memory)
	for _, m := range registry {
		byID[m.ID()] = m
	}

	// parent depends on dep
	var dm interface{} = parent
	d, ok := dm.(DependsOn)
	if !ok {
		t.Fatal("testDependentMemory should implement DependsOn")
	}
	for _, id := range d.DependsOn() {
		if _, found := byID[id]; !found {
			t.Fatalf("dependency %q not found in registry", id)
		}
	}
}

func TestSplitCSV(t *testing.T) {
	tests := []struct {
		input string
		want  int
	}{
		{"", 0},
		{"a,b,c", 3},
		{" a , b ", 2},
		{"a,,b", 2},
	}
	for _, tt := range tests {
		got := splitCSV(tt.input)
		if len(got) != tt.want {
			t.Errorf("splitCSV(%q) = %d items, want %d", tt.input, len(got), tt.want)
		}
	}
}

func TestContainsFold(t *testing.T) {
	if !containsFold("Handler.go", "handler") {
