func TestRegister(t *testing.T) {
	orig := registry
	defer func() { registry = orig }()

	registry = nil

	m := testMemory{}
	Register(m)

	if len(registry) != 1 {
		t.Fatalf("expected 1 memory in registry, got %d", len(registry))
	}
	if registry[0].ID() != "test-memory" {
		t.Fatalf("expected ID 'test-memory', got %q", registry[0].ID())
	}
}

func TestCategories(t *testing.T) {
	m := testMemory{}
	cats := categories(m)
	if len(cats) == 0 {
		t.Fatal("expected at least one category")
	}

	found := false
	for _, c := range cats {
		if c == "go-idiom" {
			found = true
		}
	}
	if !found {
		t.Fatal("expected 'go-idiom' category")
	}
}

