package main

import (
	"bufio"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"strings"
)

// claudeProjectsDir returns the path to the Claude Code projects directory.
// Honors CLAUDE_HOME if set, otherwise defaults to ~/.claude.
func claudeProjectsDir() string {
	if ch := os.Getenv("CLAUDE_HOME"); ch != "" {
		return filepath.Join(ch, "projects")
	}
	home, err := os.UserHomeDir()
	if err != nil {
		return ""
	}
	return filepath.Join(home, ".claude", "projects")
}

// FetchClaudeDialogue retrieves a Claude Code conversation from disk by its
// dialogue ID (format: "project/session").
func FetchClaudeDialogue(_ context.Context, dialogueID string) (Dialogue, error) {
	parts := strings.SplitN(dialogueID, "/", 2)
	if len(parts) != 2 {
		return Dialogue{}, fmt.Errorf("invalid dialogue ID %q: expected project/session", dialogueID)
	}

	dir := claudeProjectsDir()
	if dir == "" {
		return Dialogue{}, fmt.Errorf("cannot determine home directory")
	}
	path := filepath.Join(dir, parts[0], parts[1]+".jsonl")

	f, err := os.Open(path)
	if err != nil {
		return Dialogue{}, fmt.Errorf("open %s: %w", path, err)
	}
	defer f.Close()

	msgs, err := parseClaudeConversation(f)
	if err != nil {
		return Dialogue{}, fmt.Errorf("parse %s: %w", path, err)
	}

	return Dialogue{
		ID:       dialogueID,
		Messages: msgs,
	}, nil
}

type claudeJSONLEntry struct {
	Type        string          `json:"type"`
	IsSidechain bool            `json:"isSidechain"`
	Message     json.RawMessage `json:"message"`
}

type claudeJSONLMessage struct {
	ID      string          `json:"id"`
	Role    string          `json:"role"`
	Content json.RawMessage `json:"content"`
}

type claudeContentBlock struct {
	Type string `json:"type"`
	Text string `json:"text"`
}

func parseClaudeConversation(r io.Reader) ([]Message, error) {
	scanner := bufio.NewScanner(r)
	scanner.Buffer(make([]byte, 0, 64*1024), 10*1024*1024)

	type pendingAssistant struct {
		id    string
		texts []string
	}

	var msgs []Message
	var pending *pendingAssistant

	flushPending := func() {
		if pending != nil && len(pending.texts) > 0 {
			msgs = append(msgs, Message{
				Role:    "assistant",
				Content: strings.Join(pending.texts, ""),
			})
		}
		pending = nil
	}

	for scanner.Scan() {
		line := scanner.Bytes()
		if len(line) == 0 {
			continue
		}

		var entry claudeJSONLEntry
		if err := json.Unmarshal(line, &entry); err != nil {
			continue
		}

		if entry.IsSidechain {
			continue
		}
		if entry.Type != "user" && entry.Type != "assistant" {
			continue
		}

		var msg claudeJSONLMessage
		if err := json.Unmarshal(entry.Message, &msg); err != nil {
			continue
		}

		switch entry.Type {
		case "user":
			flushPending()
			text := extractClaudeUserText(msg.Content)
			if text == "" {
				continue
			}
			msgs = append(msgs, Message{
				Role:    "user",
				Content: text,
			})

		case "assistant":
			if pending != nil && pending.id != msg.ID {
				flushPending()
			}

			var blocks []claudeContentBlock
			if err := json.Unmarshal(msg.Content, &blocks); err != nil {
				continue
			}

			if pending == nil {
				pending = &pendingAssistant{id: msg.ID}
			}
			for _, b := range blocks {
				if b.Type == "text" && b.Text != "" {
					pending.texts = append(pending.texts, b.Text)
				}
			}
		}
	}
	flushPending()

	if err := scanner.Err(); err != nil {
		return nil, err
	}
	return msgs, nil
}

func extractClaudeUserText(raw json.RawMessage) string {
	var text string
	if json.Unmarshal(raw, &text) == nil {
		return text
	}
	var blocks []claudeContentBlock
	if json.Unmarshal(raw, &blocks) == nil {
		var sb strings.Builder
		for _, b := range blocks {
			if b.Type == "text" && b.Text != "" {
				sb.WriteString(b.Text)
			}
		}
		return sb.String()
	}
	return ""
}
