# Binaries for programs and plugins
*.exe
*.dll
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Project-local glide cache, RE: https://github.com/Masterminds/glide/issues/736
.glide/

cmd/less/*
!cmd/less/*.go
bin
target

# fractal swap files
*.swp
*.rswp
.sixrc
go.work
go.work.sum

# macos
.DS_Store

# crash files
six_crash_report_*
*.db
*.tar.gz
!**/testdata/**/*.tar.gz
# packages
pkg/

# Python local test/dev artifacts
.venv/
.venv-workers/
.wrangler/
__pycache__/
*.pyc

# llamacpp test data: GGUF models downloaded on demand for service_test.go.
# The cache subdirectory is populated by ociregistry when the
# TestService_Testdata_* suite runs with RUNE_LLAMACPP_TESTDATA=1.
cmd/rune-agent/llm/llamacpp/testdata/cache/
