# These are variables referenced thorought this file.
# Colors can be changed and range from 1 to 256.
# To see the full list of colors and its values, use
# the colorPalette command, provided by the 'colors'
# plugin below, plugin_color_palette.
color_theme_1: &color1 29
color_theme_2: &color2 95

# Alternative theme, gray tones.
#color_theme_1: &color1 246
#color_theme_2: &color2 239

frame_theme: &frame true
focus_frame_charset_theme: &focus_frame_charset
  horizontaltop: '─'
  horizontalbottom: '─'
  verticalright: '│'
  verticalleft: '│'
  topleft: '┌'
  topright: '┐'
  bottomleft: '└'
  bottomright: '┘'
frame_charset_theme: &frame_charset
  horizontaltop: '─'
  horizontalbottom: '─'
  verticalright: '│'
  verticalleft: '│'
  topleft: '┌'
  topright: '┐'
  bottomleft: '└'
  bottomright: '┘'
frameunion_charset_theme: &frameunion_charset
  left: '├'
  right: '┤'
  top: '┬'
  bottom: '┴'
frame_attr_theme: &frame_attr
  fg: *color2
focus_frame_attr_theme: &focus_frame_attr
  fg: *color1

log_path: ~/.six/debug.log
log_level: info # error, debug, trace
input_mode:
  - esc
  - mouse
vi:
  wrap: false # true for wrapping lines
# the following keys are arbitrary, and for
# identification purposes only. They contain the
# path and configuration for each of the plugins
# that are to be run alongside the editor.
plugins:
  # This plugin is used for navigating the editor's issue
  # tracker and creating new issues.
  rtc:
    path: /usr/local/bin/plugin_rtc
    config:
      # Whether to capture and send ascii images in color
      color: true
      # Frames per second for capture
      fps: 30
      # Ranges from -100 to 100, it indicates whether
      # contrast should be increased to provide clearer frames.
      contrast: 0
  issues:
    path: /usr/local/bin/plugin_issues
    config:
      bluectl_config: ~/.bluectl/config
      templates:
        # you can add more templates here. The key of the object
        # i.e. reportBug, is the name of the command to invoke this
        # issue create template.
        reportBug:
          package: six # should always be 'six'
          author: user@template
          metadata:
            bug: ""
            milestones: v0.1.0
  # This plugin is used as a general purpose syntax highlighter.
  # It's based off https://github.com/alecthomas/chroma.
  lexer:
    path: /usr/local/bin/plugin_lexer
    config:
      set_background_attr: false
      # See https://github.com/alecthomas/chroma/tree/master/styles
      # for a full list of styles.
      default_style: six
      # override default style by file extension. 'disabled' disables
      # this plugin for a file extension.
      styles:
        .go: disabled
        .rb: tango
  # This plugin is for simulating a plugin panic for debugging.
  panic:
    path: /usr/local/bin/plugin_panic
  # This plugin adds a new scheme "upspin" which implements
  # e2e encrypted workspaces. If you're interested in this feature
  # please follow instructions here: https://upspin.io/doc/signup.md.
  upspin:
    path: /usr/local/bin/plugin_upspin
  # This plugin adds a command colorPalette which opens a new window
  # and shows all the colors available to configure in the various
  # styles thorought this configuration.
  color_palette:
    path: /usr/local/bin/plugin_color_palette
  # This plugin adds a command openFileUnderCursor, which does just that.
  open_file_cursor:
    path: /usr/local/bin/plugin_open_file_cursor
  # This plugin adds a sed command to run sed scripts against the current file.
  sed:
    path: /usr/local/bin/plugin_sed
  # This plugin enables visualizing log files with the log command. If command
  # is passed without any arguments, the editor's log file is opened.
  logs:
    path: /usr/local/bin/plugin_logs
  # This plugin adds a terminal UI component to the editor. Open with newTerminal
  # or splitWindowTerminal commands.
  terminal:
    path: /usr/local/bin/plugin_terminal
    config:
      # Default shell to use rather than what's provided by the OS via $SHELL.
      #shell: bash
      ## Initial command to run. This is for advanced use cases only.
      #cmd: echo "blabla"
      # Colors
      attr:
        bg: default
        fg: default
      selection_attr:
        bg: reverse
        fg: reverse
  # This plugin adds a file information bar at the bottom.
  file_bar:
    path: /usr/local/bin/plugin_file_bar
    config:
      # Whether to show if a file has been modified.
      show_dirty: true
      # Colors
      filename_attr:
        fg: default
        bg: default
      background_attr:
        bg: default
        fg: default
      filename_dirty_attr:
        fg: *color1
      coordinates_attr:
        bg: default
        fg: default
  # This plugin adds a git changes bar to the left of the open file.
  git:
    path: /usr/local/bin/plugin_git
    config:
      # Colors
      bar_attr:
        fg: black
        bg: default
      add_attr:
        bg: green
      del_attr:
        bg: red
  # This plugin adds a fuzzy AST search component to the editor.
  # It adds searchSyntaxFunctions, searchSyntaxTypes and searchSyntaxTypes
  # commands, which use an abstraction layer to effectively query each file in the
  # workspace based on each of the programming languages supported.
  # It also adds searchSyntax command which allows passing an arbitrary query.
  # See https://tree-sitter.github.io/tree-sitter/using-parsers#query-syntax
  # for a tutorial on how to craft queries.
  fuzzy_syntax:
    path: /usr/local/bin/plugin_fuzzy_syntax
    config: {}
  # This plugin adds a fuzzy file search component to the editor. Open
  # via searchFile command.
  fuzzy_file:
    path: /usr/local/bin/plugin_fuzzy_file
    config:
      ## Command to use instead of native list files implementation.
      ## The recommended commands are the silver searcher and ripgrep.
      #command: rg -l ""
      # Whether search is case sensitive
      case_sensitive: true
      # Search algorithm. Options are fuzzy, contains and equal.
      algo: fuzzy
      # Key binding used to cycle through history.
      history_key: <c-p>
      # Max history stored
      history: 2000
      # Colors
      element_attr:
        fg: default
        bg: default
      matched_text_attr:
        fg: *color2
      count_attr:
        fg: *color1
      focus_element_attr:
        fg: *color1
  # This plugin adds a fuzzy file line search component to the editor. Open
  # via searchText command.
  fuzzy_line:
    path: /usr/local/bin/plugin_fuzzy_line
    config:
      ## Command to use instead of native list files implementation.
      ## The recommended commands are the silver searcher and ripgrep.
      #command: rg --color never -n --no-heading --max-columns 500 ""
      # Whether search is case sensitive
      case_sensitive: true
      # Search algorithm. Options are fuzzy, contains and equal.
      algo: fuzzy
      # Key binding used to cycle through history.
      history_key: <c-\>
      # Max history stored
      history: 2000
      # Colors
      element_attr:
        fg: default
        bg: default
      matched_text_attr:
        fg: *color1
      count_attr:
        fg:
          - *color1
          - bold
      focus_element_attr:
        fg:
          - *color1
          - bold
  # This plugin adds LSP functionality (Language Server Protocol).
  # This adds formatting, go to definition, search references, get
  # symbol documentation, and diagnostics in the form of errors and warnings.
  # Only go and C/C++ is supported for now, but you're welcome to try
  # LSP servers by adding new rows below in `exec`.
  lsp:
    path: /usr/local/bin/plugin_lsp
    config:
      # References searching window colors
      references_window_attr:
        fg: default
        Tg: black
      # timeout to connect to LSP server.
      connect_timeout: 10s
      # Timeout to run individual RPCs against LSP server.
      # This should be large for large workspaces.
      rpc_timeout: 30s
      disconnect_timeout: 300ms
      # configure syntax highlighting colors
      syntax_highlighting:
        interface: yellow
        struct: default
        typeParameter: default
        parameter: default
        variable:  default
        property: default
        enumMember: default
        event: default
        method: default
        function: default
        member: default
        macro: default
        keyword: yellow
        modifier: yellow
        comment: blue
        string: magenta
        number: red
      # Enable/disable syntax highlighting by file extension.
      enable_semantic_tokens:
        .go: true
      # Enable a LSP server for a file extension. The format is
      # <.extension>: <path to lsp executable> <args>
      exec:
        .go: gopls -mode stdio
        .c: clangd

# Configuration for the command prompt.
command:
  # Key to open the command prompt.
  key: ":"
  # Max number of commands stored in history.
  max_history: 2000
  # Configure arbitrary command alises.
  aliases:
    # aliases can be used to disambiguate commands from others,
    # creating shortcuts.
    ref: lspReferences
    issues: addWorkspace bluectl+issues:///
    config: edit ~/.sixrc
    # You can also add combinations of commands to be run
    # as a single command.
    layout:
      - splitWindowTerminal
      - focusPrevWindow
      - searchFile
  # Configure bindings from key combinations to commands.
  key_bindings:
    <c-x><c-h>: focusPrevWindow
    <c-x><c-l>: focusNextWindow
    <c-x><c-j>: focusBelowWindow
    <c-x><c-k>: focusAboveWindow
    <c-x><c-w>: closeWindow
    <c-x>h: changeSplitOrientation h
    <c-x>v: changeSplitOrientation v
    <c-j>: lspNextDiagnostic
    <c-k>: lspPrevDiagnostic
    <c-t>: lspHover
    <c-g>: lspGoToDefinition
    <c-b>: lspFormat
    <c-p>: searchFile
    <c-\>: searchText
    # <c-x><enter>: newWindow
    <c-x><enter>: splitWindowTerminal
    gf: openFileUnderCursor
  # Colors
  element_attr:
    fg: default
    bg: default
  matched_text_attr:
    fg: *color1
    bg: default
  focus_element_attr:
    fg:
      - *color2
      - bold

browser:
  # Whether to add the URI of the workspace to the workspace bar
  workspace_bar_uri: false
  window_manager:
    dim: true
    frame: *frame
    frame_attr: *frame_attr
    focus_frame_attr: *focus_frame_attr
    frame_charset: *frame_charset
    focus_frame_charset: *focus_frame_charset
    frameunion_charset: *frameunion_charset
  message_bar_attr:
    fg: *color1
    bg: default
  focus_tab_attr:
    fg:
      - default
      - bold
  dirty_tab_attr:
    fg:
      - *color1
    bg: default
  non_focus_tab_attr:
    fg: *color2
  # Prompt configuration. This prompted is used by the editor
  # to ask questions to the user.
  prompt:
    # Dimensions
    height: 14
    width: 50
    # Colors
    text_attr:
      fg: default
      bg: default
    highlight_attr:
      fg: white
      bg: *color1

# Workspaces configuration.
workspace:
  # Configuration for upspin client to connect to workspaces.
  upspin:
    username: ernest@unstable.build
    dirserver: remote,upspin.unstable.build:443
    storeserver: remote,upspin.unstable.build:443
    packing: ee
  # Configuration for remote workspaces to connect over SSH.
  ssh:
    # Use a shell different than the one configured by the remote system.
    # shell: ""
    # Maximum amount of time for the TCP connection to establish.
    # timeout: 5s
    # private_keys:
    #  - ~/.ssh/id_rsa
    # Instead of using private_keys and a go native implementation
    # of ssh, use the given command to start an ssh session. This could be
    # useful for environments which deploy a highly customized ~/.ssh/config.
    # The command should contain '%h' to subsitute for the workspace's host
    # and '%p' if custom ports are needed. If this option is set, private_keys,
    # insecure, and timeout are ignored.
    # command: ssh -q %h
  ## Workspace wallpaper. Override default six wallpaper with your ASCII art.
  #wallpaper: myAsciiArt
  wallpaper_attr:
    fg: *color2
  #wallpaper_background_attr:
    #bg: default
